# Demo dashboard local config. Copy to `.env` (gitignored) and fill in your
# Google OAuth client to enable "Sign in with Google":
#
#   cp demo/dashboard/.env.example demo/dashboard/.env
#   # edit the two values below, then:
#   make demo-up            # (or: go run ./demo/dashboard)
#
# Real exported environment variables always override this file.

# ── Google OAuth (enables the Gmail "Sign in with Google" flow) ──────────────
# Create a *Web application* OAuth client (see this folder's README.md) with the
# authorized redirect URI http://localhost:8090/oauth/callback, then paste:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only change this if you are not serving the demo on localhost:8090:
# GOOGLE_REDIRECT_URL=http://localhost:8090/oauth/callback

# ── Optional overrides (defaults are fine for `make demo-up`) ────────────────
# DEMO_ADDR=:8090
# KAFKA_BROKERS=localhost:9092
# SVC01_SCAN_URL=http://localhost:8081/api/v1/scan
# DEMO_API_KEY=cs_demokey000000000000000000000DEMO
# GMAIL_POLL_INTERVAL=1m
# GMAIL_TOKEN_FILE=demo/dashboard/.gmail-token   # persist the connection across restarts
