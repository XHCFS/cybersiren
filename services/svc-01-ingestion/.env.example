# =============================================================================
# CyberSiren SVC-01 (Ingestion) — Environment Variables
#
# Service-scoped reference for services/svc-01-ingestion. Copy the values you
# need into your deployment environment or the repo-root .env file. SECRETS
# (OAuth client secret, refresh token, push token) belong here / in your secret
# manager — NEVER in committed YAML.
#
# Env var → config key mapping: CYBERSIREN_<SECTION>__<FIELD>, double underscore
# delimits hierarchy (see shared/config). Precedence: process env > .env file >
# config.yaml > defaults.
# =============================================================================

# -- Runtime -------------------------------------------------------------------
CYBERSIREN_ENV=development
CYBERSIREN_LOG__LEVEL=info
CYBERSIREN_LOG__PRETTY=true

# -- Required shared validation fields -----------------------------------------
# shared/config.Validate() requires these even for svc-01.
CYBERSIREN_AUTH__JWT_SECRET=replace-with-a-long-random-secret
CYBERSIREN_AUTH__API_KEY_PREFIX=cs_
CYBERSIREN_AUTH__API_KEY_PREFIX_LEN=32

# -- Postgres ------------------------------------------------------------------
CYBERSIREN_DB__HOST=localhost
CYBERSIREN_DB__PORT=5432
CYBERSIREN_DB__NAME=cybersiren
CYBERSIREN_DB__USER=cybersiren_app
CYBERSIREN_DB__PASSWORD=changeme
CYBERSIREN_DB__SSL_MODE=disable

# -- Valkey (dedup, quota, Gmail history cursor) -------------------------------
CYBERSIREN_VALKEY__ADDR=localhost:6379
CYBERSIREN_VALKEY__DB=0
CYBERSIREN_VALKEY__PASSWORD=

# -- Kafka / Redpanda ----------------------------------------------------------
CYBERSIREN_KAFKA__BROKERS=localhost:9092
CYBERSIREN_KAFKA__CLIENT_ID=cybersiren

# -- Observability -------------------------------------------------------------
CYBERSIREN_JAEGER_ENDPOINT=
CYBERSIREN_METRICS_PORT=9090

# =============================================================================
# -- Gmail adapter (ARCH-SPEC §2.1) --------------------------------------------
# OAuth2 offline (refresh-token) + Google Pub/Sub PUSH → svc-01 /gmail/push,
# with a history.list fallback poll loop. See README.md "Gmail live setup".
#
# Leave CYBERSIREN_GMAIL__ENABLED=false to run API-upload only — then none of
# the values below are required.
# =============================================================================
CYBERSIREN_GMAIL__ENABLED=false

# OAuth app credentials (Google Cloud Console → APIs & Services → Credentials).
CYBERSIREN_GMAIL__CLIENT_ID=
CYBERSIREN_GMAIL__CLIENT_SECRET=
CYBERSIREN_GMAIL__REDIRECT_URL=http://localhost:8081/oauth/callback

# Long-lived offline refresh token (obtained once via the consent flow — see
# README "Obtain the refresh token"). SECRET.
CYBERSIREN_GMAIL__REFRESH_TOKEN=

# Mailbox to watch/poll ("me" = the consenting user, or an email address).
CYBERSIREN_GMAIL__USER=me

# Tenant the watched mailbox belongs to. A Pub/Sub push carries no API key, so
# ingested Gmail mail is bound to THIS org (org from config, never the body —
# G10). Must match an organisations.id in the DB.
CYBERSIREN_GMAIL__ORG_ID=1

# Scope (default gmail.readonly per the spec). A single scope via env is fine;
# for MULTIPLE scopes/labels use config.yaml (a YAML list) — the env provider
# does NOT split a comma-separated value into a slice.
CYBERSIREN_GMAIL__SCOPES=https://www.googleapis.com/auth/gmail.readonly

# Which label watch()/history.list react to (default INBOX). One label via env;
# use config.yaml for multiple.
CYBERSIREN_GMAIL__LABEL_IDS=INBOX

# -- Delivery: Pub/Sub push (primary) ------------------------------------------
CYBERSIREN_GMAIL__PUSH_ENABLED=true
# Fully-qualified Pub/Sub topic the watch() call targets. REQUIRED for push.
CYBERSIREN_GMAIL__WATCH_TOPIC=projects/your-gcp-project/topics/gmail-push
# Shared secret appended to the push-subscription endpoint as ?token=... ; the
# /gmail/push handler rejects requests whose token does not match. STRONGLY
# RECOMMENDED. SECRET.
CYBERSIREN_GMAIL__PUSH_TOKEN=
# Optional: expected OIDC `aud` claim when the push subscription uses a
# service-account identity (defence-in-depth on top of PUSH_TOKEN).
CYBERSIREN_GMAIL__PUSH_AUDIENCE=

# -- Delivery: fallback poll ---------------------------------------------------
CYBERSIREN_GMAIL__POLL_ENABLED=true
CYBERSIREN_GMAIL__POLL_INTERVAL=5m

# Per-request Gmail API timeout.
CYBERSIREN_GMAIL__HTTP_TIMEOUT=30s

# -- Test/override endpoints (leave empty in production) -----------------------
# Point the adapter at a mock server in tests; empty = real Google endpoints.
CYBERSIREN_GMAIL__API_BASE_URL=
CYBERSIREN_GMAIL__TOKEN_URL=
