# =============================================================================
# CyberSiren — Docker Compose Environment Variables
# =============================================================================
# Copy this file to .env in the same directory (deploy/compose/.env).
# These values are used by docker-compose.yml for infra services only.
#
# NOTE: This is separate from the repo-root .env.example which controls
# application-level config (CYBERSIREN_* vars). This file controls the
# Docker infrastructure (container ports, credentials, etc.).
# =============================================================================

# -- PostgreSQL ----------------------------------------------------------------
POSTGRES_DB=cybersiren
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# -- Valkey --------------------------------------------------------------------
VALKEY_PORT=6379

# -- Kafka ---------------------------------------------------------------------
KAFKA_PORT=9092
KAFKA_UI_PORT=8080

# -- MinIO (S3-compatible object storage) --------------------------------------
# Local dev credentials only — never use these in production.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=cybersiren-attachments

# -- pgAdmin -------------------------------------------------------------------
# Local dev only — never use this in production.
PGADMIN_PORT=5050
PGADMIN_PASSWORD=admin

# -- Observability -------------------------------------------------------------
JAEGER_UI_PORT=16687
GRAFANA_PORT=3002

# -- TI Feed API Keys ----------------------------------------------------------
# These are passed into the svc-11-ti-sync container.
# ThreatFox and MalwareBazaar require an API key (free registration at abuse.ch).
# PhishTank and OpenPhish keys are optional.
FEED_THREATFOX_API_KEY=
FEED_PHISHTANK_API_KEY=
FEED_OPENPHISH_API_KEY=
FEED_MALWAREBAZAAR_API_KEY=

# -- Non-bypass application DB role (RLS enforcement, migration 031) -----------
# Services connect as POSTGRES_USER (superuser) until each adopts the
# WithOrgTx/SetOrgGUC pattern on every path (batch 1a+). This DSN points at the
# non-bypass role that PROVES cross-org isolation: `make test-rls`.
APP_DB_USER=cybersiren_app
APP_DB_PASSWORD=cybersiren_app
APP_DATABASE_URL=postgres://cybersiren_app:cybersiren_app@localhost:5432/cybersiren?sslmode=disable

# ── Consumer portal Gmail sign-in (full profile) ─────────────────────────────
# Optional. Set these to enable "Sign in with Google" in the inbox scanner
# portal (:8090). Create an OAuth client (Web app) in Google Cloud, add your
# Gmail as a test user, and set the authorized redirect URI to
# http://localhost:8090/oauth/callback. Without these the portal still works
# for .eml upload/paste; only the Gmail door is hidden.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8090/oauth/callback

# ── svc-09 notification webhook (optional; ntfy POC) ─────────────────────────
# When enabled, svc-09 POSTs an alert JSON to NOTIFY_WEBHOOK_URL on a
# phishing/malware verdict (or risk >= org threshold). Point at an ntfy topic and
# subscribe on your phone. The demo org seeds "webhook" in notification_channels.
NOTIFY_WEBHOOK_ENABLED=false
# Via the prettifying adapter (titled push): http://ntfy-adapter:8099/alert
# Or post raw JSON straight to a topic: https://ntfy.sh/<your-topic>
NOTIFY_WEBHOOK_URL=http://ntfy-adapter:8099/alert
# Topic the ntfy-adapter publishes to.
NTFY_URL=https://ntfy.sh/cybersiren-cie21-alerts
