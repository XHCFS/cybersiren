# ── svc-01-ingestion ─────────────────────────────────────────────────────────
# Receives raw emails and publishes them to Kafka for downstream analysis.

# Stage 1: builder
FROM golang:1.25-alpine AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" \
    -o /bin/service ./services/svc-01-ingestion/cmd/ingestion/

# Stage 2: final
FROM alpine:3.19
RUN apk --no-cache add ca-certificates tzdata
WORKDIR /app
COPY --from=builder /bin/service /bin/service
# Demo UI (B4): served same-origin by svc-01 from ./static (relative to WORKDIR).
COPY services/svc-01-ingestion/static/ ./static/
ENTRYPOINT ["/bin/service"]
