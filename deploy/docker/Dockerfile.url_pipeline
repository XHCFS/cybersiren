# ── svc-03-url-analysis (PIPELINE binary) ────────────────────────────────────
# The Spine pipeline consumer (cmd/url-pipeline): consumes analysis.urls,
# scores each URL (L1 TI/heuristics + L2 ML fusion), publishes scores.url.
# Same Python ML runtime + GeoIP as the demo image — it spawns
# inference_script.py and (when GeoIP is present) enriches in-process and
# scores via the fusion sidecar's /score-features.

# Stage 1: Go builder
FROM golang:1.25-alpine AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" \
    -o /bin/service ./services/svc-03-url-analysis/cmd/url-pipeline/

# Stage 2: final (python:3.12-slim has pre-built wheels — no C++ compilation)
FROM python:3.12-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates tzdata libgomp1 \
    && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir joblib numpy lightgbm xgboost scikit-learn tldextract

WORKDIR /app
COPY --from=builder /bin/service /bin/service
COPY services/svc-03-url-analysis/ml/inference_script.py /app/ml/inference_script.py
COPY services/svc-03-url-analysis/ml/model.joblib /app/ml/model.joblib
COPY services/svc-03-url-analysis/ml/config.json /app/ml/config.json
COPY services/svc-03-url-analysis/ml/data/top-1m.csv /app/ml/data/top-1m.csv
# GeoIP databases (LFS) — when present the Go enricher loads them and svc-03
# scores via the sidecar /score-features endpoint; absent → falls back to /score.
COPY fusion_export/fusion_kit/GeoLite2-City.mmdb /app/geoip/GeoLite2-City.mmdb
COPY fusion_export/fusion_kit/GeoLite2-ASN.mmdb /app/geoip/GeoLite2-ASN.mmdb

ENV CYBERSIREN_ML__URL_MODEL_PATH=/app/ml/inference_script.py
ENV CYBERSIREN_PHISHING__GEOIP_DIR=/app/geoip
ENTRYPOINT ["/bin/service"]
